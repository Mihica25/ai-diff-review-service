PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5433/ai_diff_review
BEARER_TOKEN=change-me

# Optional — only needed to use provider: "llm". The service boots and
# serves the (scored) mock provider fine with neither of these set; a
# request for provider: "llm" then fails gracefully instead of crashing.
# Get a key at https://console.anthropic.com (API Keys).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Used only by docker-compose.yml for local Postgres
POSTGRES_DB=ai_diff_review
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
